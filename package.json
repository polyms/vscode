{
  "name": "vscode",
  "displayName": "Polyms",
  "description": "An arctic, north-bluish clean and elegant Visual Studio Code theme.",
  "version": "0.0.8",
  "publisher": "polyms",
  "engines": {
    "vscode": ">=1.105.0"
  },
  "categories": [
    "Extension Packs",
    "Themes",
    "Other"
  ],
  "keywords": [
    "icon-theme",
    "theme",
    "polyms"
  ],
  "homepage": "https://github.com/polyms/vscode",
  "icon": "assets/favicon.png",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "dotenv",
        "aliases": [
          "Dotenv",
          "Environment variables"
        ],
        "extensions": [
          ".env"
        ],
        "filenames": [
          ".env"
        ],
        "filenamePatterns": [
          "**/.env.*",
          "**/*.env"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "themes": [
      {
        "label": "Polyms",
        "uiTheme": "vs-dark",
        "path": "./themes/polyms-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "polyms-vs",
        "label": "Polyms",
        "path": "./themes/polyms-icons.json"
      }
    ],
    "grammars": [
      {
        "language": "dotenv",
        "scopeName": "source.dotenv",
        "path": "./syntaxes/dotenv.tmLanguage.json"
      },
      {
        "path": "./syntaxes/sql-highlight.json",
        "scopeName": "inline-sql.injection",
        "injectTo": [
          "source.python",
          "source.java",
          "source.ruby",
          "source.cs",
          "source.js",
          "source.ts",
          "source.vue",
          "source.svelte",
          "source.tsx",
          "source.rust",
          "text.html.php"
        ],
        "embeddedLanguages": {
          "meta.embedded.sql": "sql"
        }
      }
    ],
    "commands": [
      {
        "command": "polyms.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "extensionPack": [
    "mhutchie.git-graph",
    "christian-kohler.path-intellisense",
    "pflannery.vscode-versionlens",
    "redhat.vscode-yaml",
    "bradlc.vscode-tailwindcss",
    "vitest.explorer",
    "redhat.vscode-xml",
    "esbenp.prettier-vscode",
    "biomejs.biome",
    "eamodio.gitlens",
    "dbaeumer.vscode-eslint"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.js",
    "package": "pnpm build && vsce package",
    "publish": "vsce publish",
    "lint": "biome check .",
    "format": "biome format . --write",
    "watch": "node esbuild.js --watch",
    "release": "release-it --ci --increment patch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^24.12.2",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "release-it": "^20.0.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polyms/vscode.git"
  }
}
