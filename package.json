{
  "name": "vscode",
  "displayName": "Polyms",
  "description": "Polyms themes, file icons, and built-in AI Kit MCP integration for Visual Studio Code.",
  "version": "0.0.10",
  "publisher": "polyms",
  "engines": {
    "vscode": ">=1.105.0"
  },
  "categories": [
    "Extension Packs",
    "Themes",
    "Other"
  ],
  "keywords": [
    "icon-theme",
    "theme",
    "polyms",
    "mcp",
    "ai-kit"
  ],
  "homepage": "https://github.com/polyms/vscode",
  "icon": "assets/favicon.png",
  "contributes": {
    "languages": [
      {
        "id": "dotenv",
        "aliases": [
          "Dotenv",
          "Environment variables"
        ],
        "extensions": [
          ".env"
        ],
        "filenames": [
          ".env"
        ],
        "filenamePatterns": [
          "**/.env.*",
          "**/*.env"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "themes": [
      {
        "label": "Polyms",
        "uiTheme": "vs-dark",
        "path": "./themes/polyms-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "polyms-vs",
        "label": "Polyms",
        "path": "./themes/polyms-icons.json"
      }
    ],
    "grammars": [
      {
        "language": "dotenv",
        "scopeName": "source.dotenv",
        "path": "./syntaxes/dotenv.tmLanguage.json"
      },
      {
        "path": "./syntaxes/sql-highlight.json",
        "scopeName": "inline-sql.injection",
        "injectTo": [
          "source.python",
          "source.java",
          "source.ruby",
          "source.cs",
          "source.js",
          "source.ts",
          "source.vue",
          "source.svelte",
          "source.tsx",
          "source.rust",
          "text.html.php"
        ],
        "embeddedLanguages": {
          "meta.embedded.sql": "sql"
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "polyms.aiKit",
        "label": "AI Kit"
      }
    ],
    "configuration": {
      "title": "Polyms",
      "properties": {
        "polyms.aiKitMcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Provide the AI Kit remote MCP server to VS Code Copilot Chat. Authentication is handled by VS Code when connecting."
        }
      }
    }
  },
  "extensionPack": [
    "mhutchie.git-graph",
    "christian-kohler.path-intellisense",
    "pflannery.vscode-versionlens",
    "redhat.vscode-yaml",
    "bradlc.vscode-tailwindcss",
    "vitest.explorer",
    "redhat.vscode-xml",
    "esbenp.prettier-vscode",
    "biomejs.biome",
    "eamodio.gitlens",
    "dbaeumer.vscode-eslint"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && node esbuild.js",
    "package": "pnpm run build && vsce package",
    "publish": "vsce publish",
    "lint": "biome check .",
    "format": "biome format . --write",
    "watch": "node esbuild.js --watch",
    "release": "release-it --ci --increment patch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "release-it": "^21.1.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polyms/vscode.git"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
